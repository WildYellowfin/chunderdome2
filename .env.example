# Required in production: any long random string (openssl rand -base64 32)
SESSION_SECRET=

# Comma-separated phone numbers of trip owners (always admins). E.g. +14155550123
OWNER_PHONES=

# Storage: add the "Upstash for Redis" integration on Vercel and these are set for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Sign-in, pick one:
# 1) Real SMS codes via Twilio Verify (best)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# 2) A shared passcode you post in the group chat
# TRIP_CODE=chunder
